import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import com.kla.loggingservice.dto.response.fileupload.CsvValidationResponse;
import com.kla.loggingservice.dto.response.fileupload.DuplicateError;
import com.kla.loggingservice.dto.response.fileupload.ValidationError;
import com.kla.loggingservice.entity.EdocProject;
import com.opencsv.CSVReader;

@Service
public class FileUploadService {

    @PersistenceContext
    private EntityManager entityManager;
    
    private static final Logger log = 
			LoggerFactory.getLogger(FileUploadService.class);

    @Transactional
    public CsvValidationResponse validateAndProcess(MultipartFile file) {
    	log.info("File validation started");
        List<ValidationError> validationErrors = new ArrayList<>();
        List<DuplicateError> duplicateErrors = new ArrayList<>();

        Map<String, List<Integer>> duplicateMap = new HashMap<>();
        List<EdocProject> validData = new ArrayList<>();
        
        Authentication authentication =
	            SecurityContextHolder.getContext().getAuthentication();

        String loggedInUser = authentication.getName();
        Instant updatedAt = Instant.now();

        try (Reader reader =
                new InputStreamReader(file.getInputStream(), StandardCharsets.UTF_8);
            CSVReader csvReader = new CSVReader(reader)) {

           List<String[]> rows = csvReader.readAll();

           String[] rawHeader = rows.get(0);
           List<String> headerList = new ArrayList<>();

           for (int i = 0; i < rawHeader.length; i++) {

               String col = rawHeader[i];

               if (col != null) {
                   if (i == 0 && !col.isEmpty()
                           && col.charAt(0) == '\uFEFF') {
                       col = col.substring(1);
                   }

                   col = col.trim().toLowerCase();
               } else {
                   col = "";
               }

               headerList.add(col);
           }
			
			List<String> requiredColumns = Arrays.asList(
			        "edocprojname","edocprojid","regionid",
			        "regionname","divname","divid","plmproject","pnlist"
			);

			if (!headerList.containsAll(requiredColumns)) {
				log.error("Invalid CSV Header: {}", headerList);
			    throw new RuntimeException("Invalid CSV header: " + headerList);
			}
			
            int nameIndex = headerList.indexOf("edocprojname");
            int idIndex = headerList.indexOf("edocprojid");
            int regionIdIndex = headerList.indexOf("regionid");
            int regionNameIndex = headerList.indexOf("regionname");
            int divNameIndex = headerList.indexOf("divname");
            int divIdIndex = headerList.indexOf("divid");
            int plmIndex = headerList.indexOf("plmproject");
            int pnIndex = headerList.indexOf("pnlist");
            
            for (int i = 1; i < rows.size(); i++) {

                String[] row = rows.get(i);
                int rowNum = i + 1;

                boolean hasError = false;
                
                for (int j = 0; j < rawHeader.length; j++) {
                    String columnName = rawHeader[j];
                    String value = (j < row.length) ? row[j] : null;

                    if (value == null || value.trim().isEmpty()) {
                        ValidationError error = new ValidationError();
                        error.setRow(rowNum);
                        error.setColumn(columnName);
                        error.setMessage("Value is null or empty");

                        validationErrors.add(error);
                        hasError = true;
                    }
                }

                if (hasError) continue;
                
                String key = row[idIndex].trim() + "_" + row[nameIndex].trim();

                duplicateMap.computeIfAbsent(key, k -> new ArrayList<>())
                        .add(rowNum);
                
                EdocProject e = new EdocProject();
                e.setEdocprojid(Integer.parseInt(row[idIndex]));
                e.setEdocprojname(row[nameIndex]);
                e.setRegionid(Integer.parseInt(row[regionIdIndex]));
                e.setRegionname(row[regionNameIndex]);
                e.setDivname(row[divNameIndex]);
                e.setDivid(Integer.parseInt(row[divIdIndex]));
                e.setPlmproject(row[plmIndex]);
                e.setPnlist(Boolean.parseBoolean(row[pnIndex]));
                e.setUpdatedBy(loggedInUser);
                e.setUpdatedAt(updatedAt);
                validData.add(e);
            }

            // BUILD DUPLICATE ERROR RESPONSE
            for (Map.Entry<String, List<Integer>> entry : duplicateMap.entrySet()) {

                if (entry.getValue().size() > 1) {

                    String[] split = entry.getKey().split("_");

                    DuplicateError error = new DuplicateError();
                    error.setEdocprojid(Integer.parseInt(split[0]));
                    error.setEdocprojname(split[1]);
                    error.setRows(entry.getValue());

                    duplicateErrors.add(error);
                }
            }

            // IF ANY ERROR → STOP INSERT
            if (!validationErrors.isEmpty() || !duplicateErrors.isEmpty()) {
            	log.warn("File validation error occured");
                CsvValidationResponse response = new CsvValidationResponse();
                response.setStatus("FAILED");
                response.setValidationErrors(validationErrors);
                response.setDuplicateErrors(duplicateErrors);

                return response;
            }
            
            // DELETE OLD DATA FIRST
            log.info("Deleting old data");
            entityManager.createQuery("DELETE FROM EdocProject").executeUpdate();

            // INSERT ONLY CLEAN DATA
            log.info("Inserting new CSV data");
            for (EdocProject e : validData) {
                entityManager.persist(e);
            }

            CsvValidationResponse response = new CsvValidationResponse();
            response.setStatus("SUCCESS");

            return response;

        } catch (Exception e) {
        	e.printStackTrace();
        	log.error("CSV processing failed");
            throw new RuntimeException("CSV processing failed", e);
        }
    }
}



